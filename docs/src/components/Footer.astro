---
import EditLink from '@astrojs/starlight/components/EditLink.astro';
---

<footer class="wt-edit-footer">
  <EditLink />
</footer>

<style>
  .wt-edit-footer {
    display: flex;
    margin-block-start: 3rem;
    color: var(--wt-ink-muted);
    font-size: var(--sl-text-sm);
  }

  .wt-edit-footer:empty {
    display: none;
  }
</style>
